---
extends: default

# Copied data: the evaluation sets (from the old repo) and the test copies of the gitops
# policies. They are kept byte-identical to their source, so they are not reformatted.
ignore: |
  .venv/
  eval/*.yaml
  tests/policy/

rules:
  line-length:
    max: 160
  truthy:
    allowed-values: ["true", "false"]
    check-keys: false
  comments:
    min-spaces-from-content: 1
  comments-indentation: false
  braces:
    max-spaces-inside: 1
  document-start: disable
